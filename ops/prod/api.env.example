# /opt/docker/battlecrm/api.env (600). APP_VERSION comes from the image, APP_ORIGIN from APP_HOST in .env.
# The app role (ADR 0009): never the owner, never the superuser.
DATABASE_URL=postgres://battlecrm_app:<APP_PASSWORD>@postgres:5432/battlecrm
# The subnet of traefik-public: docker network inspect traefik-public --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXIES=
# Signs the session cookies: openssl rand -base64 48. Changing it signs every User out.
BETTER_AUTH_SECRET=
# The Gmail account that sends the e-mails, and one of its app passwords (never the account's password).
SMTP_USER=
SMTP_PASSWORD=
# Optional: the sender's name (BattleCRM).
#EMAIL_FROM_NAME=BattleCRM
# Closed unless true. Before opening: the legal work of spec stack §16.
SIGNUPS_OPEN=false
# Optional: the push URL of the uptime-kuma monitor "BattleCRM API", up to its token (no query string).
# Without it, the API sends no alert.
#UPTIME_KUMA_PUSH_URL=https://<uptime-kuma>/api/push/<token>
# Optional: LOG_LEVEL (info), PORT (3000).

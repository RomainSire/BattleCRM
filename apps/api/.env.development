# Development only, against compose.dev.yml. Production values live on the VPS (spec stack §10.4).
DATABASE_URL=postgres://battlecrm_app:app@localhost:5432/battlecrm
MIGRATION_DATABASE_URL=postgres://battlecrm_owner:owner@localhost:5432/battlecrm
APP_VERSION=dev
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
# Development only: never a production secret.
BETTER_AUTH_SECRET=development-secret-development-secret
SIGNUPS_OPEN=true
# E-mails leave through the real Gmail (spec stack §8): put SMTP_USER and SMTP_PASSWORD (an app password)
# in apps/api/.env.development.local, which git ignores. Test accounts use the +n aliases of SMTP_USER.

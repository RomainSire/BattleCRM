{
  "name": "@battlecrm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env.development src/main.ts | pino-pretty",
    "build": "tsdown",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "db:migrate": "node --env-file=.env.development src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:drift": "drizzle-kit generate && git diff --exit-code -- drizzle && test -z \"$(git ls-files --others --exclude-standard -- drizzle)\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "0.45.3",
    "hono": "catalog:",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.23.0"
  }
}

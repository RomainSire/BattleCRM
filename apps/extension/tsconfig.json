{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    // Firefox only (spec extension §9): the global `browser`, with its own APIs such as `sidebarAction`.
    "types": ["firefox-webext-browser"]
  },
  // `.wxt/` comes from `wxt prepare` (postinstall): `#imports` and the build's `import.meta.env`.
  "include": [
    "src",
    "test/*.ts",
    "test/*.tsx",
    "*.config.ts",
    "web-ext.config.example.ts",
    ".wxt/wxt.d.ts"
  ]
}

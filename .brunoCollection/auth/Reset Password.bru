meta {
  name: Reset Password
  type: http
  seq: 6
}

post {
  url: http://localhost:3333/api/auth/reset-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "paste-raw-token-from-email-here",
    "password": "newPassword123",
    "passwordConfirmation": "newPassword123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

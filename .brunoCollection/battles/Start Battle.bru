meta {
  name: Start Battle
  type: http
  seq: 3
}

post {
  url: http://localhost:3333/api/battles
  body: json
  auth: inherit
}

body:json {
  {
    "funnel_stage_id": "{{funnelStageId}}",
    "variant_a_id": "{{variantAId}}",
    "variant_b_id": "{{variantBId}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
